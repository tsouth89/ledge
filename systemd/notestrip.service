[Unit]
Description=NoteStrip - sticky notes on the edge of the screen
Documentation=https://github.com/tsouth89/notestrip
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/notestrip run-shell
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
