[Desktop Entry]
Type=Application
Name=NoteStrip
GenericName=Sticky Notes
Comment=Sticky notes that live on the edge of your screen
Exec=notestrip start
Icon=notestrip
Terminal=false
Categories=Utility;TextEditor;
Actions=NewNote;AllNotes;
Keywords=notes;sticky;memo;todo;
StartupNotify=false
# The strip is a layer surface with no window of its own, so a launcher has
# nothing to wait for or group under.
NoDisplay=false

[Desktop Action NewNote]
Name=New note
Exec=notestrip new

[Desktop Action AllNotes]
Name=All notes
Exec=notestrip all
