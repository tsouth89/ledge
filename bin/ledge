#!/usr/bin/env bash
# ledge - edge-docked sticky notes for Hyprland
set -euo pipefail

LEDGE_VERSION=0.1.0

find_shell_dir() {
  if [[ -n ${LEDGE_SHELL_DIR:-} && -f $LEDGE_SHELL_DIR/shell.qml ]]; then
    printf '%s' "$LEDGE_SHELL_DIR"; return
  fi
  local here; here=$(dirname "$(readlink -f "$0")")
  local candidate
  for candidate in /usr/share/ledge/shell "$here/../shell"; do
    if [[ -f $candidate/shell.qml ]]; then
      printf '%s' "$(readlink -f "$candidate")"; return
    fi
  done
  echo "ledge: cannot locate shell.qml; set LEDGE_SHELL_DIR" >&2
  exit 1
}

SHELL_DIR=$(find_shell_dir)

running() { qs ipc --path "$SHELL_DIR" call ledge ping >/dev/null 2>&1; }

start() {
  if running; then echo "ledge: already running"; return 0; fi
  qs --path "$SHELL_DIR" --daemonize
  # The IPC target only registers once the config finishes loading.
  for _ in $(seq 1 40); do running && return 0; sleep 0.1; done
  echo "ledge: started but IPC did not come up" >&2
  return 1
}

# Every note-touching command needs a live instance, since the notes model and
# the file writes both live inside it.
ipc() {
  running || start >/dev/null
  qs ipc --path "$SHELL_DIR" call ledge "$@"
}

usage() {
  cat <<'USAGE'
ledge - sticky notes that live on the edge of the screen

  ledge start | stop | restart | status
  ledge new [text]        create a note and open it; bare `ledge new` toggles,
                          so pressing the same key again puts it away
  ledge add [text]        append to the most recent note (reads stdin)
  ledge list              every note as JSON
  ledge all               open the All Notes window (search, archive, trash)
  ledge attach <id>       attach the image on the clipboard to a note
  ledge remind <id> <when>  remind you about a note (15m, 2h, 3d, ISO, or clear)
  ledge export [path]     write every note to one markdown file
  ledge trash             list deleted notes as JSON
  ledge restore <file>    bring a deleted note back
  ledge open <id>         open one note for editing
  ledge rm <id>           move a note to the trash
  ledge move <id> <n>     move a note to position n on the strip (0 is first)
  ledge pop <id>          detach a note to float on the desktop
  ledge place <id> <x> <y>  move a floating note (global screen coordinates)
  ledge dock <id>         send a floating note back to the strip
  ledge peek              fan the strip open without opening a note
  ledge close             collapse the strip
  ledge log               tail the running instance's log
  ledge dir               print the data directory
  ledge version           version and environment, for bug reports

Notes live in ~/.local/share/ledge/notes as plain markdown files.
Settings live in ~/.config/ledge/config.json.
USAGE
}

# Read positional args, falling back to stdin so `... | ledge add` works.
#
# Only a pipe or a redirected file counts as stdin. Testing `! -t 0` alone is
# wrong here: launched from a Hyprland keybind there is no tty either, and this
# would sit reading a descriptor that may never close.
body_from() {
  if [[ $# -gt 0 ]]; then printf '%s' "$*"
  elif [[ -p /dev/stdin || -f /dev/stdin ]]; then cat
  else printf ''
  fi
}

cmd=${1:-start}
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
  start)   start ;;
  stop)
    if running; then qs kill --path "$SHELL_DIR"; else echo "ledge: not running"; fi ;;
  restart)
    if running; then qs kill --path "$SHELL_DIR" >/dev/null 2>&1 || true; fi
    sleep 0.4
    start ;;
  status)
    if running; then echo "running  (shell: $SHELL_DIR)"; else echo "stopped  (shell: $SHELL_DIR)"; fi ;;
  # Bare `ledge new` toggles: it opens a blank note, or closes the open one.
  # Given text it always creates, so scripts and pipes behave predictably.
  new)
    if [[ $# -eq 0 && ! -p /dev/stdin && ! -f /dev/stdin ]]; then ipc toggleNew
    else ipc create "$(body_from "$@")"; fi ;;
  add)     ipc append "$(body_from "$@")" ;;
  list)    ipc list ;;
  all)     ipc all ;;
  attach)  [[ $# -ge 1 ]] || { echo "ledge: attach needs a note id" >&2; exit 2; }; ipc attach "$1" ;;
  remind)  [[ $# -ge 2 ]] || { echo "ledge: remind needs a note id and a time (15m, 2h, 3d, an ISO timestamp, or 'clear')" >&2; exit 2; }; ipc remind "$1" "$2" ;;
  export)  ipc exportAll "${1:-}" "${2:-true}" ;;
  trash)   ipc refreshTrash >/dev/null; sleep 0.35; ipc trash ;;
  restore) [[ $# -ge 1 ]] || { echo "ledge: restore needs a trash filename (see 'ledge trash')" >&2; exit 2; }; ipc restore "$1" ;;
  open)    [[ $# -ge 1 ]] || { echo "ledge: open needs a note id" >&2; exit 2; }; ipc open "$1" ;;
  rm)      [[ $# -ge 1 ]] || { echo "ledge: rm needs a note id" >&2; exit 2; }; ipc remove "$1" ;;
  pop)     [[ $# -ge 1 ]] || { echo "ledge: pop needs a note id" >&2; exit 2; }; ipc pop "$1" ;;
  place)   [[ $# -ge 3 ]] || { echo "ledge: place needs a note id, x and y" >&2; exit 2; }; ipc place "$1" "$2" "$3" ;;
  dock)    [[ $# -ge 1 ]] || { echo "ledge: dock needs a note id" >&2; exit 2; }; ipc dock "$1" ;;
  move)    [[ $# -ge 2 ]] || { echo "ledge: move needs a note id and a position" >&2; exit 2; }; ipc move "$1" "$2" ;;
  peek)    ipc peek ;;
  close)   ipc close ;;
  dir)     echo "${LEDGE_DATA_DIR:-$HOME/.local/share/ledge}" ;;
  version|--version|-V)
    # Everything a bug report needs, in one place.
    echo "ledge $LEDGE_VERSION"
    echo "  shell:      $SHELL_DIR"
    echo "  data:       ${LEDGE_DATA_DIR:-$HOME/.local/share/ledge}"
    echo "  config:     ${LEDGE_CONFIG:-$HOME/.config/ledge/config.json}"
    echo "  quickshell: $(qs --version 2>/dev/null | head -1 || echo 'not found')"
    echo "  compositor: $(hyprctl version 2>/dev/null | head -1 || echo 'not Hyprland')"
    echo "  running:    $(running && echo yes || echo no)"
    ;;
  log)     qs log --path "$SHELL_DIR" ;;
  -h|--help|help) usage ;;
  *)       echo "ledge: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
