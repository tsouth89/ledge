#!/usr/bin/env bash
# notestrip - edge-docked sticky notes for Hyprland
set -euo pipefail

NOTESTRIP_VERSION=0.2.0

# Keep scripts written for the 0.1 name working through the rename.
if [[ -z ${NOTESTRIP_SHELL_DIR:-} && -n ${LEDGE_SHELL_DIR:-} ]]; then
  export NOTESTRIP_SHELL_DIR=$LEDGE_SHELL_DIR
fi
if [[ -z ${NOTESTRIP_DATA_DIR:-} && -n ${LEDGE_DATA_DIR:-} ]]; then
  export NOTESTRIP_DATA_DIR=$LEDGE_DATA_DIR
fi
if [[ -z ${NOTESTRIP_CONFIG:-} && -n ${LEDGE_CONFIG:-} ]]; then
  export NOTESTRIP_CONFIG=$LEDGE_CONFIG
fi

data_dir() {
  printf '%s' "${NOTESTRIP_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/notestrip}"
}

config_file() {
  printf '%s' "${NOTESTRIP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/notestrip/config.json}"
}

# Version 0.1 stored user state under the old project name. Move it only when
# both sides are unambiguous, then leave a compatibility symlink so an old
# script or package cannot create a second, divergent note library.
migrate_legacy_state() {
  [[ -z ${NOTESTRIP_DATA_DIR:-} && -z ${LEDGE_DATA_DIR:-} ]] || return 0

  local data_home config_home old new
  data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  config_home=${XDG_CONFIG_HOME:-$HOME/.config}

  old="$data_home/ledge"
  new="$data_home/notestrip"
  if [[ -d $old && ! -e $new && ! -L $new ]]; then
    mv -- "$old" "$new"
    ln -s -- "$new" "$old"
  fi

  [[ -z ${NOTESTRIP_CONFIG:-} && -z ${LEDGE_CONFIG:-} ]] || return 0
  old="$config_home/ledge"
  new="$config_home/notestrip"
  if [[ -d $old && ! -e $new && ! -L $new ]]; then
    mv -- "$old" "$new"
    ln -s -- "$new" "$old"
  fi
}

find_shell_dir() {
  if [[ -n ${NOTESTRIP_SHELL_DIR:-} && -f $NOTESTRIP_SHELL_DIR/shell.qml ]]; then
    printf '%s' "$NOTESTRIP_SHELL_DIR"; return
  fi
  local here; here=$(dirname "$(readlink -f "$0")")
  local candidate
  for candidate in /usr/share/notestrip/shell "$here/../shell"; do
    if [[ -f $candidate/shell.qml ]]; then
      printf '%s' "$(readlink -f "$candidate")"; return
    fi
  done
  echo "notestrip: cannot locate shell.qml; set NOTESTRIP_SHELL_DIR" >&2
  exit 1
}

SHELL_DIR=$(find_shell_dir)

running() { qs ipc --path "$SHELL_DIR" call notestrip ping >/dev/null 2>&1; }

start() {
  migrate_legacy_state
  if running; then echo "notestrip: already running"; return 0; fi
  qs --path "$SHELL_DIR" --daemonize
  # The IPC target only registers once the config finishes loading.
  for _ in $(seq 1 40); do running && return 0; sleep 0.1; done
  echo "notestrip: started but IPC did not come up" >&2
  return 1
}

# Every note-touching command needs a live instance, since the notes model and
# the file writes both live inside it.
ipc() {
  running || start >/dev/null
  qs ipc --path "$SHELL_DIR" call notestrip "$@"
}

usage() {
  cat <<'USAGE'
notestrip - sticky notes that live on the edge of the screen

  notestrip start | stop | restart | status
  notestrip stats             internal health counters as JSON
  notestrip new [text]        create a note as a sticky on the desktop; bare
                          `notestrip new` toggles, so pressing the same key again
                          puts it away
  notestrip add [text]        append to the most recent note (reads stdin)
  notestrip list              every note as JSON
  notestrip all               open the All Notes window (search, archive, trash)
  notestrip attach <id>       attach the image on the clipboard to a note
  notestrip remind <id> <when>  remind you about a note (15m, 2h, 3d, ISO, or clear)
  notestrip export [path]     write every note to one markdown file
  notestrip trash             list deleted notes as JSON
  notestrip restore <file>    bring a deleted note back
  notestrip open <id>         open one note for editing
  notestrip copy <id>         copy a note's text to the clipboard
  notestrip rm <id>           move a note to the trash
  notestrip move <id> <n>     move a note to position n on the strip (0 is first)
  notestrip pop <id>          detach a note to float on the desktop
  notestrip place <id> <x> <y>  move a floating note (global screen coordinates)
  notestrip dock <id>         send a floating note back to the strip
  notestrip peek              fan the strip open without opening a note
  notestrip close             collapse the strip
  notestrip log               tail the running instance's log
  notestrip dir               print the data directory
  notestrip install-desktop   add NoteStrip to your launcher (only needed from a clone)
  notestrip version           version and environment, for bug reports

Notes live in ~/.local/share/notestrip/notes as plain markdown files.
Settings live in ~/.config/notestrip/config.json.
USAGE
}

# Read positional args, falling back to stdin so `... | notestrip add` works.
#
# Only a pipe or a redirected file counts as stdin. Testing `! -t 0` alone is
# wrong here: launched from a Hyprland keybind there is no tty either, and this
# would sit reading a descriptor that may never close.
body_from() {
  if [[ $# -gt 0 ]]; then printf '%s' "$*"
  elif [[ -p /dev/stdin || -f /dev/stdin ]]; then cat
  else printf ''
  fi
}

cmd=${1:-start}
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
  start)   start ;;
  stop)
    if running; then qs kill --path "$SHELL_DIR"; else echo "notestrip: not running"; fi ;;
  restart)
    if running; then qs kill --path "$SHELL_DIR" >/dev/null 2>&1 || true; fi
    sleep 0.4
    start ;;
  status)
    if running; then echo "running  (shell: $SHELL_DIR)"; else echo "stopped  (shell: $SHELL_DIR)"; fi ;;
  stats)   ipc stats ;;
  # Bare `notestrip new` toggles: it opens a blank note, or closes the open one.
  # Given text it always creates, so scripts and pipes behave predictably.
  new)
    if [[ $# -eq 0 && ! -p /dev/stdin && ! -f /dev/stdin ]]; then ipc toggleNew
    else ipc newFloating "$(body_from "$@")"; fi ;;
  add)     ipc append "$(body_from "$@")" ;;
  list)    ipc list ;;
  all)     ipc all ;;
  attach)  [[ $# -ge 1 ]] || { echo "notestrip: attach needs a note id" >&2; exit 2; }; ipc attach "$1" ;;
  remind)  [[ $# -ge 2 ]] || { echo "notestrip: remind needs a note id and a time (15m, 2h, 3d, an ISO timestamp, or 'clear')" >&2; exit 2; }; ipc remind "$1" "$2" ;;
  export)  ipc exportAll "${1:-}" "${2:-true}" ;;
  trash)   ipc refreshTrash >/dev/null; sleep 0.35; ipc trash ;;
  restore) [[ $# -ge 1 ]] || { echo "notestrip: restore needs a trash filename (see 'notestrip trash')" >&2; exit 2; }; ipc restore "$1" ;;
  open)    [[ $# -ge 1 ]] || { echo "notestrip: open needs a note id" >&2; exit 2; }; ipc open "$1" ;;
  rm)      [[ $# -ge 1 ]] || { echo "notestrip: rm needs a note id" >&2; exit 2; }; ipc remove "$1" ;;
  copy)    [[ $# -ge 1 ]] || { echo "notestrip: copy needs a note id" >&2; exit 2; }; ipc copy "$1" ;;
  pop)     [[ $# -ge 1 ]] || { echo "notestrip: pop needs a note id" >&2; exit 2; }; ipc pop "$1" ;;
  place)   [[ $# -ge 3 ]] || { echo "notestrip: place needs a note id, x and y" >&2; exit 2; }; ipc place "$1" "$2" "$3" ;;
  dock)    [[ $# -ge 1 ]] || { echo "notestrip: dock needs a note id" >&2; exit 2; }; ipc dock "$1" ;;
  move)    [[ $# -ge 2 ]] || { echo "notestrip: move needs a note id and a position" >&2; exit 2; }; ipc move "$1" "$2" ;;
  peek)    ipc peek ;;
  close)   ipc close ;;
  dir)     data_dir; echo ;;
  install-desktop)
    # Register with menus and launchers when running from a clone. The packaged
    # build installs these itself; this is the equivalent for a working tree.
    #
    # The Exec line is an absolute path on purpose: a launcher does not
    # necessarily have ~/.local/bin on PATH, and a desktop entry that silently
    # fails to launch is worse than none.
    self=$(readlink -f "$0")
    root=$(dirname "$(dirname "$self")")
    apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
    mkdir -p "$apps" "$icons"
    if [[ -f $root/assets/notestrip.svg ]]; then
      install -m644 "$root/assets/notestrip.svg" "$icons/notestrip.svg"
    fi
    sed "s|^Exec=notestrip |Exec=$self |" "$root/notestrip.desktop" > "$apps/notestrip.desktop"
    chmod 644 "$apps/notestrip.desktop"
    command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null
    command -v gtk-update-icon-cache >/dev/null && \
      gtk-update-icon-cache -qtf "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" 2>/dev/null
    echo "installed $apps/notestrip.desktop"
    echo "installed $icons/notestrip.svg"
    ;;

  version|--version|-V)
    # Everything a bug report needs, in one place.
    echo "notestrip $NOTESTRIP_VERSION"
    echo "  shell:      $SHELL_DIR"
    echo "  data:       $(data_dir)"
    echo "  config:     $(config_file)"
    echo "  quickshell: $(qs --version 2>/dev/null | head -1 || echo 'not found')"
    echo "  compositor: $(hyprctl version 2>/dev/null | head -1 || echo 'not Hyprland')"
    echo "  running:    $(running && echo yes || echo no)"
    ;;
  run-shell)
    migrate_legacy_state
    exec qs --path "$SHELL_DIR"
    ;;
  migrate-state) migrate_legacy_state ;;
  log)     qs log --path "$SHELL_DIR" ;;
  -h|--help|help) usage ;;
  *)       echo "notestrip: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
